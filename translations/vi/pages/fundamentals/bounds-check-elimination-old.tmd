kể từ Go Toolchain 1.11, compiler trở nên thông minh hơn

func ff(s []int) []int {
	s2 := make([]int, len(s))
	for i := range s {
		s2[i] = -s[i] // line 41: kiểm tra giới hạn, compiler chưa đủ thông minh
	}
	return s2
}

func ff2(s []int) []int {
	s2 := make([]int, len(s))
	s2 = s2[:len(s)] // line 48: để tránh kiểm tra giới hạn ở dòng 50
